# Copy to .env and fill in. `.env` is git-ignored and must never be committed.

# MySQL (used by docker-compose for the mysql service AND by the app)
MYSQL_DATABASE=scm_db
MYSQL_USER=scm
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# App datasource (local dev without Docker: point at your own MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/scm_db
SPRING_DATASOURCE_USERNAME=scm
SPRING_DATASOURCE_PASSWORD=change-me

# Optional: which risk algorithm bean to activate (Strategy pattern)
SENTINEL_RISK_STRATEGY=weighted
